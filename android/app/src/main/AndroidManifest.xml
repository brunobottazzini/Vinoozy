<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Firebase SDKs talk to Google APIs over TLS only (NFR4.8). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- connectivity_plus: first sign-in needs to know whether a network exists (NFR2.5). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Label photo (u6-label-recognition NFR4.2): the system camera and the
         system photo picker need no permission, so none of these may reach the
         merged manifest, even if a dependency declares one. Declaring CAMERA
         would also make ACTION_IMAGE_CAPTURE fail until it is granted.
         Checked on the merged release manifest by tool/check_release_build.sh. -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>

    <!-- allowBackup=false and the data extraction rules keep the pending-writes
         ledger and the Firestore cache off backups and device transfers (NFR8.4).
         usesCleartextTraffic=false: only the debug variant opens 10.0.2.2 for the
         emulators, through its own network security config (NFR4.8). -->
    <application
        android:label="Vinoozy"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- "Share -> Vinoozy" with one or more images (u6 BR1.4, NFR4.4):
                 only SEND and SEND_MULTIPLE of image/*, no other action.
                 SharedImageReceiver keeps only the first content:// URI. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <!-- "Share -> Vinoozy" of the text selected in Google Lens
                 (label-autofill-windows FR2.1, NFR3.3): only ACTION_SEND of
                 text/plain. The text stays in memory until the form reads it
                 and is cut to 4000 characters (SharedImageReceiver). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- "Apri in Google Lens" (label-recognition FR4.3, NFR3.3): the
             prepared front photo leaves only through this provider, limited to
             cache/label/ (res/xml/label_file_paths.xml), never exported, with a
             temporary read grant per URI. Checked by tool/check_lens_manifest.sh. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.labelfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/label_file_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- label-recognition BR5.2: whether the Google app (Lens) is installed,
             and the apps of the share menu for an image; nothing else. -->
        <package android:name="com.google.android.googlequicksearchbox"/>
        <!-- label-autofill-windows FR2.6, BR2.5: the Google Lens app, opened by
             "From Google Lens" with its launch intent; no permission. -->
        <package android:name="com.google.ar.lens"/>
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="image/*"/>
        </intent>
    </queries>
</manifest>
