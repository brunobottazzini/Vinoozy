        {
          "label": "invitation with the counter (SharingRepository.invite)",
          "requiresRules": "sharing",
          "op": "batch",
          "writes": [
            {
              "op": "set",
              "path": "cellars/$uid/members/$inviteeEmail",
              "data": {
                "inviteeEmail": "$inviteeEmail",
                "permission": "read",
                "status": "invited",
                "invitedAt": "$serverTimestamp",
                "ownerId": "$uid",
                "ownerName": "User A",
                "updatedAt": "$serverTimestamp"
              }
            },
            {
              "op": "update",
              "path": "cellars/$uid",
              "data": {
                "memberSlots": "$increment:1",
                "memberOpKey": "$inviteeEmail"
              }
            }
          ]
        },
        {
          "label": "activation by the invited person (SharingRepository.activate)",
          "requiresRules": "sharing",
          "as": "invitee",
          "op": "update",
          "path": "cellars/$uid/members/$inviteeEmail",
          "data": {
            "status": "active",
            "inviteeUserId": "$inviteeUid",
            "inviteeName": "compat-invitee",
            "updatedAt": "$serverTimestamp"
          }
        },
        {
          "label": "permission changed to edit (SharingRepository.changePermission)",
          "requiresRules": "sharing",
          "op": "batch",
          "writes": [
            {
              "op": "update",
              "path": "cellars/$uid/members/$inviteeEmail",
              "data": {
                "permission": "edit",
                "updatedAt": "$serverTimestamp"
              }
            }
          ]
        },
        {
          "label": "wine created by the invited person with edit",
          "requiresRules": "sharing",
          "as": "invitee",
          "op": "set",
          "path": "cellars/$uid/wines/compat-w3",
          "data": {
            "name": "Nebbiolo",
            "vintage": 2019,
            "quantity": 1,
            "updatedBy": "$inviteeUid",
            "createdAt": "$serverTimestamp",
            "updatedAt": "$serverTimestamp"
          }
        },
        {
          "label": "quantity changed by the invited person with edit",
          "requiresRules": "sharing",
          "as": "invitee",
          "op": "update",
          "path": "cellars/$uid/wines/compat-w1",
          "data": {
            "quantity": "$increment:-1",
            "updatedAt": "$serverTimestamp",
            "updatedBy": "$inviteeUid"
          }
        },
        {
          "label": "the invited person leaves (SharingRepository.leave)",
          "requiresRules": "sharing",
          "as": "invitee",
          "op": "batch",
          "writes": [
            {
              "op": "update",
              "path": "cellars/$uid/members/$inviteeEmail",
              "data": {
                "status": "revoked",
                "closedBy": "invitee",
                "updatedAt": "$serverTimestamp"
              }
            },
            {
              "op": "update",
              "path": "cellars/$uid",
              "data": {
                "memberSlots": "$increment:-1",
                "memberOpKey": "$inviteeEmail"
              }
            }
          ]
        },
        {
          "label": "a closed access invited again (SharingRepository.invite)",
          "requiresRules": "sharing",
          "op": "batch",
          "writes": [
            {
              "op": "update",
              "path": "cellars/$uid/members/$inviteeEmail",
              "data": {
                "status": "invited",
                "permission": "read",
                "invitedAt": "$serverTimestamp",
                "closedBy": "$deleteField",
                "updatedAt": "$serverTimestamp"
              }
            },
            {
              "op": "update",
              "path": "cellars/$uid",
              "data": {
                "memberSlots": "$increment:1",
                "memberOpKey": "$inviteeEmail"
              }
            }
          ]
        },
        {
          "label": "revocation by the owner (SharingRepository.revoke)",
          "requiresRules": "sharing",
          "op": "batch",
          "writes": [
            {
              "op": "update",
              "path": "cellars/$uid/members/$inviteeEmail",
              "data": {
                "status": "revoked",
                "closedBy": "owner",
                "updatedAt": "$serverTimestamp"
              }
            },
            {
              "op": "update",
              "path": "cellars/$uid",
              "data": {
                "memberSlots": "$increment:-1",
                "memberOpKey": "$inviteeEmail"
              }
            }
          ]
        },
        {
          "label": "a closed access deleted for good (SharingRepository.deleteClosed)",
          "requiresRules": "sharing",
          "op": "batch",
          "writes": [
            {
              "op": "delete",
              "path": "cellars/$uid/members/$inviteeEmail"
            }
          ]
        },
        {
          "label": "wine deleted by the owner (opened by u7-sharing for u4-cellar)",
          "requiresRules": "sharing",
          "op": "delete",
          "path": "cellars/$uid/wines/compat-w2"
        }
      ]
    },
