# BEGIN AI-DLC:gitignore
# AI-DLC: local working files
aidlc/active-space
aidlc/spaces/*/intents/active-intent
aidlc/.aidlc-clone-id
aidlc.settings.local.json
aidlc/.aidlc-unit-scope.json
aidlc/.aidlc-unit-parked
aidlc/.aidlc-claim-generations.json
aidlc/.aidlc-unit-participant
aidlc/.aidlc-claim-registry.json
aidlc/.aidlc-unit-releases/
aidlc/.aidlc-unit-merges/
aidlc/.aidlc-active-space-*.tmp
aidlc/active-memory/
aidlc/.aidlc-sessions/
aidlc/.aidlc-request-text/
aidlc/spaces/*/intents/.aidlc-*
**/aidlc/spaces/*/intents/**/.aidlc-engine/
**/aidlc/spaces/*/intents/**/.aidlc-sensors/
aidlc/spaces/*/knowledge/documentkb/.journal/
aidlc/spaces/*/knowledge/.sources.local.json
aidlc/spaces/*/intents/*/runtime-graph.json
aidlc/spaces/*/intents/*/.aidlc-*
aidlc/diagnostics/
.claude/settings.local.json
# END AI-DLC:gitignore

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
packages/estimation/coverage/
*.iml
.idea/
.vscode/
.DS_Store

# Generated by tool/gen_coverage_helper.dart before each coverage run
test/coverage_helper_test.dart

# Android
android/.gradle/
android/captures/
android/local.properties
android/app/.cxx/
android/key.properties

# Node (firebase-tools, rules tests)
node_modules/

# Firebase emulators
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
.firebase/

# Production configuration and signing material: generated by release.yml from
# GitHub Actions secrets, never committed (NFR4.7)
android/app/google-services.json
config/firebase_prod.json
*.jks
*.keystore
