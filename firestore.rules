rules_version = '2';

// Vinoozy security rules (u1-skeleton security-design.md §2, NFR4.1-NFR4.5,
// NFR4.11; u7-sharing security-design.md §1, NFR4.1-NFR4.9; u4-cellar
// security-design.md §1, NFR4.1-NFR4.9; u8-account security-design.md §1
// and §7, NFR4.1-NFR4.4).
// Shared file: u1-skeleton owns the common functions, users and the owner's
// cellar; u7-sharing owns `members`, the invited people's access, the
// `memberSlots` counter and `drinkingRecords`. u4-cellar extends, as a
// declared extension (functional-spec.md of u4-cellar), the wine fields
// (`matchKey`, `baseWindow`, `windowAdjustment`, window validation, the
// `matchKey` backfill), the cellar flag `matchKeyBackfill` and the
// `drinkingRecords` block (`condition`, `updatedAt`, update by the author or
// the owner, "Undo" by the author within 10 minutes). Every rule change must
// keep accepting the writes of the app version still in production
// (test/rules/compat/).
//
// Document accesses per evaluated path (u7 NFR5.2: at most 3 per path).
// get/exists/getAfter of the same document in one request count once.
//
//   Path and operation                                  | Accesses
//   ----------------------------------------------------|---------------------
//   wines, drinkingRecords: owner read or write         | 1 (cellar)
//   wines, drinkingRecords: invited person read/write   | 2 (cellar, members)
//   cellars/{id}: get by an invited person              | 1 (members)
//   cellars/{id}: update of memberSlots                 | 2 (members before
//                                                       |    and after)
//   members: create, update, delete                     | 2 (cellar before and
//                                                       |    after)
//   collection group members: read                      | 0
//   users/{uid}: create, update, delete (u8-account)    | 0
//   cellars/{id}: delete by the owner (u8-account)      | 1 (users profile)
//
// A management batch (cellar + members) totals 4, well under the 20 per
// batch of Firestore.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Common functions -------------------------------------------------

    // Google is the only provider (NFR4.1): anonymous and email tokens fail.
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function uid() {
      return request.auth.uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function onlyChanged(fields) {
      return incoming().diff(existing()).affectedKeys().hasOnly(fields);
    }

    // One document read per wine read or write (counted in NFR5.2).
    function cellarOwner(cellarId) {
      return get(/databases/$(database)/documents/cellars/$(cellarId)).data.ownerId;
    }

    // ---- Sharing: identity and access (u7-sharing NFR4.1, NFR4.4) ---------

    // The invitee identity is the lower-case token email, and only when
    // Google says it is verified (always true for Google accounts).
    function email() {
      return request.auth.token.get('email', '').lower();
    }

    function verified() {
      return request.auth.token.get('email_verified', false) == true;
    }

    function memberPath(cellarId) {
      return /databases/$(database)/documents/cellars/$(cellarId)/members/$(email());
    }

    function isOwner(cellarId) {
      return cellarOwner(cellarId) == uid();
    }

    // Only an `active` invitation gives access; `invited` does not until the
    // person activates it (BR1.4).
    function isActiveMember(cellarId) {
      return verified()
        && exists(memberPath(cellarId))
        && get(memberPath(cellarId)).data.status == 'active';
    }

    function canReadCellar(cellarId) {
      return isOwner(cellarId) || isActiveMember(cellarId);
    }

    function canEditCellar(cellarId) {
      return isOwner(cellarId)
        || (isActiveMember(cellarId)
          && get(memberPath(cellarId)).data.permission == 'edit');
    }

    // ---- users/{userId} (NFR4.2) -----------------------------------------

    // u8-account (security-design.md §7): the profile may also be created
    // with `deletionStartedAt`, when the account deletion starts before U1
    // created it; the required fields stay those of U1.
    function validUserCreate() {
      let data = incoming();
      let required = ['displayName', 'email', 'onboardingSeen', 'createdAt', 'schemaVersion'];
      let allowed = ['displayName', 'email', 'onboardingSeen', 'createdAt', 'schemaVersion',
                     'deletionStartedAt'];
      return data.keys().hasOnly(allowed)
        && data.keys().hasAll(required)
        && (!('deletionStartedAt' in data) || data.deletionStartedAt == request.time)
        && data.displayName is string
        && data.email is string
        && data.onboardingSeen == false
        && data.createdAt == request.time
        && data.schemaVersion == 1;
    }

    function validUserUpdate() {
      let data = incoming();
      return onlyChanged(['displayName', 'email', 'onboardingSeen'])
        && data.displayName is string
        && data.email is string
        && data.onboardingSeen is bool;
    }

    // u8-account NFR4.2: `deletionStartedAt` is written once, by the user,
    // with the server time, and never changed or removed afterwards
    // (validUserUpdate does not allow it).
    function validDeletionStart() {
      return !('deletionStartedAt' in existing())
        && onlyChanged(['deletionStartedAt'])
        && incoming().deletionStartedAt == request.time;
    }

    match /users/{userId} {
      allow get: if signedIn() && userId == uid();
      allow create: if signedIn() && userId == uid() && validUserCreate();
      allow update: if signedIn() && userId == uid()
        && (validUserUpdate() || validDeletionStart());
      allow list: if false;
      // u8-account NFR4.1: only the user, and only during an account
      // deletion (security-design.md §7).
      allow delete: if signedIn() && userId == uid()
        && existing().get('deletionStartedAt', null) != null;
    }

    // u8-account NFR4.3: the user started the deletion of their account.
    // One document access (the profile).
    function deletingAccount() {
      return get(/databases/$(database)/documents/users/$(uid())).data
        .get('deletionStartedAt', null) != null;
    }

    // ---- cellars/{cellarId} (NFR4.3, NFR4.11) ----------------------------

    function validCellarName(name) {
      return name is string && name.size() >= 1 && name.size() <= 60;
    }

    function validCellarCreate() {
      let data = incoming();
      let fields = ['ownerId', 'name', 'createdAt', 'schemaVersion'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && data.ownerId == uid()
        && data.createdAt == request.time
        && data.schemaVersion == 1
        && validCellarName(data.name);
    }

    match /cellars/{cellarId} {

      // ---- memberSlots counter (u7-sharing BR1.2, BR1.13, NFR4.3) ---------
      // Every batch that changes the open invitations writes the cellar with
      // memberSlots +1 or -1 and memberOpKey = the invitation key, plus that
      // invitation. A batch writes the cellar once, so one key, so one
      // invitation can pair with the counter change.

      function slotsBefore() {
        return resource.data.get('memberSlots', 0);
      }

      function opMember() {
        return /databases/$(database)/documents/cellars/$(cellarId)/members/$(incoming().memberOpKey);
      }

      function slotDelta(delta) {
        return incoming().memberSlots == slotsBefore() + delta;
      }

      // New invitation or renewal of a closed one.
      function opAdds() {
        return getAfter(opMember()).data.status == 'invited'
          && (!exists(opMember()) || get(opMember()).data.status == 'revoked');
      }

      // Revocation or exit.
      function opRemoves() {
        return exists(opMember())
          && get(opMember()).data.status in ['invited', 'active']
          && getAfter(opMember()).data.status == 'revoked';
      }

      function validSlotsUpdate() {
        let data = incoming();
        return onlyChanged(['memberSlots', 'memberOpKey'])
          && data.memberSlots is int
          && data.memberOpKey is string
          && data.memberOpKey.size() <= 254
          && data.memberSlots >= 0
          && data.memberSlots <= 2
          && ((existing().ownerId == uid()
              && ((slotDelta(1) && opAdds()) || (slotDelta(-1) && opRemoves())))
            || (verified()
              && data.memberOpKey == email()
              && slotDelta(-1)
              && opRemoves()
              && getAfter(opMember()).data.get('closedBy', '') == 'invitee'));
      }

      // Short circuit: the owner may read cellars/{uid} even before it exists.
      // An invited person with an active invitation reads name and owner.
      allow get: if signedIn()
        && (cellarId == uid() || resource.data.ownerId == uid() || isActiveMember(cellarId));
      // Unchanged: shared cellars are found through the invitations.
      allow list: if signedIn() && resource.data.ownerId == uid();
      allow create: if signedIn() && cellarId == uid() && validCellarCreate();
      // u4-cellar NFR4.9: the one-off matchKey backfill is marked done by the
      // owner or an `edit` member, only from absent/false to true.
      allow update: if signedIn()
        && ((existing().ownerId == uid()
            && onlyChanged(['name'])
            && validCellarName(incoming().name))
          || validSlotsUpdate()
          || (onlyChanged(['matchKeyBackfill'])
            && resource.data.get('matchKeyBackfill', false) == false
            && incoming().matchKeyBackfill == true
            && canEditCellar(cellarId)));
      // u8-account NFR4.3 (security-design.md §7): only the owner, and only
      // during the deletion of their account. Outside it a cellar is never
      // deleted, so no wines or drinks are left orphaned for a recreated
      // cellar; a drifted memberSlots does not block the deletion.
      allow delete: if signedIn()
        && existing().ownerId == uid()
        && deletingAccount();

      // ---- cellars/{cellarId}/wines/{wineId} (NFR4.4, NFR4.5) ------------

      // label-autofill-windows BR5.1: `level` and `windowOverride` are
      // optional; wines saved without them stay valid (NFR1.1).
      function wineFields() {
        return ['name', 'producer', 'vintage', 'wineType', 'region', 'denomination',
                'quantity', 'window', 'pairings', 'createdAt', 'updatedAt', 'updatedBy',
                'matchKey', 'baseWindow', 'windowAdjustment', 'country',
                'level', 'windowOverride',
                // wine-style-profiles BR10.1: all optional.
                'style', 'typeSource', 'levelSource', 'styleSource',
                'agingStartMonth', 'migrationVersion'];
      }

      // wine-style-profiles BR10.2: disgorgement or bottling month and year.
      function validAgingStart(a) {
        return a == null || (a is map
          && a.keys().hasOnly(['year', 'month'])
          && a.keys().hasAll(['year', 'month'])
          && a.year is int && a.year >= 1900 && a.year <= 2200
          && a.month is int && a.month >= 1 && a.month <= 12);
      }

      // wine-style-profiles BR10.2: version of the one-off migration.
      function validMigrationVersion(v) {
        return v == null || (v is int && v >= 1 && v <= 1000);
      }

      // label-autofill-windows BR5.1: the level is one of three names.
      function validLevel(l) {
        return l == null || l in ['everyday', 'good', 'aging'];
      }

      // label-autofill-windows BR5.1: the owner's end year (1900..2200),
      // set with the server time. Checked only when it changes, so an
      // unrelated edit of a corrected wine keeps passing (review R-09).
      function validOverride(o) {
        return o == null || (o is map
          // wine-style-profiles BR6.8: optional end month.
          && o.keys().hasOnly(['endYear', 'setAt', 'endMonth'])
          && (!('endMonth' in o)
            || (o.endMonth is int && o.endMonth >= 1 && o.endMonth <= 12))
          && o.keys().hasAll(['endYear', 'setAt'])
          && o.endYear is int && o.endYear >= 1900 && o.endYear <= 2200
          && o.setAt == request.time);
      }

      // ux-redesign FR1.5: the country is optional, an ISO 3166-1 alpha-2
      // code in upper case. Wines saved without it stay valid (NFR4).
      function validCountry(c) {
        return c == null || (c is string && c.matches('^[A-Z]{2}$'));
      }

      // u4-cellar NFR4.1: `window` and `baseWindow` share the C2 shape;
      // `basis` stays optional for the windows saved before it existed.
      // label-autofill-windows BR5.1: basis `grape`, the foreign qualifiers,
      // and the optional `denominationKey` (1-60 characters) and
      // `tablesVersion` (an integer, BR3.9).
      // wine-style-profiles BR10.2: `peakYear` and `endYear` optional (not
      // estimated), `unit` with the months, the profile, the anchor and the
      // flags; the order is checked on the values present, as one integer
      // per date: year * 12 + month for a window in months, the year for a
      // window in years (unit absent included). The optional fields are read
      // with `get` and a default that passes, so a window costs few
      // expressions: the rules evaluate at most 1000 per request and a wine
      // write may carry two windows.
      function validWindow(w) {
        return w == null || (w is map
          && w.keys().hasOnly(['startYear', 'peakYear', 'endYear', 'confidence', 'source',
                               'basis', 'qualifier', 'denominationKey', 'tablesVersion',
                               'unit', 'startMonth', 'peakMonth', 'endMonth', 'profile',
                               'anchor', 'anchorFallback', 'indicative'])
          && w.startYear is int && w.startYear >= 1900
          // confidence and source (required: reading a missing one fails),
          // then the optional descriptions with a default that passes, joined
          // and matched by one regular expression; a value that is not a
          // string or a bool makes the expression fail.
          && (w.confidence + '|' + w.source + '|' + w.get('basis', 'catalog') + '|'
              + w.get('anchor', 'vintage') + '|' + w.get('profile', 'UNKNOWN') + '|'
              + w.get('qualifier', 'riserva') + '|'
              + string(w.get('anchorFallback', false)) + '|'
              + string(w.get('indicative', false))).matches(
            '^(high|medium|low)[|](catalog|internalRules)[|]'
            + '(catalog|denomination|grape|wineType|generic)[|]'
            + '(vintage|bottling|disgorgement)[|]'
            + '(R_FRESH|R_MEDIUM|R_AGE|R_LONG|W_FRESH|W_MEDIUM|W_AGE|ROSE_FRESH|'
            + 'SP_TANK|LAM_FRESH|SP_CLASSIC|SP_CLASSIC_AGE|SW_AROMATIC|SW_PASSITO|'
            + 'SW_BOTRYTIS|PORT_VINTAGE|PORT_LBV|PORT_OX|SH_FINO|SH_AMONT|'
            + 'SH_OLOROSO|SH_PX|FORT_UNKNOWN|UNKNOWN)[|]'
            + '(riserva|superiore|granSelezione|crianza|reserva|granReserva|'
            + 'premierCru|grandCru|kabinett|spatlese|auslese|vintage|lbv|colheita|'
            + 'beerenauslese|trockenbeerenauslese|eiswein)[|](true|false)[|](true|false)$')
          && (w.get('unit', 'years') == 'years' ? validYearWindow(w) : validMonthWindow(w))
          && (!('denominationKey' in w)
            || (w.denominationKey is string
              && w.denominationKey.size() >= 1 && w.denominationKey.size() <= 60))
          && (!('tablesVersion' in w)
            || (w.tablesVersion is int && w.tablesVersion >= 1 && w.tablesVersion <= 1000)));
      }

      // wine-style-profiles: the base window (the estimate before the drink
      // feedback and the owner's correction). Equal to the window (checked in
      // full in the same request): nothing more. Different only in its dates
      // and confidence (a drink feedback or a correction): every other field
      // must be equal to the window's, so its descriptions are the checked
      // ones, and its start, confidence and dates (integers, months 1..12,
      // order) are checked here. Otherwise it is checked in full. This keeps
      // a wine write within the 1000 expressions a request may evaluate
      // (test/rules/style_profiles.rules.test.mjs, "expression budget").
      function validBaseWindow(b, w) {
        return b == w
          || (b is map && w is map
            && b.diff(w).affectedKeys().hasOnly(['startYear', 'peakYear', 'endYear',
                 'startMonth', 'peakMonth', 'endMonth', 'confidence'])
            && b.startYear is int && b.startYear >= 1900
            && b.confidence in ['high', 'medium', 'low']
            && (b.get('unit', 'years') == 'years' ? validYearWindow(b) : validMonthWindow(b)))
          || validWindow(b);
      }

      // A window in years: the years present ordered, at most 2200.
      function validYearWindow(w) {
        let peak = w.get('peakYear', w.startYear);
        let end = w.get('endYear', w.get('peakYear', w.startYear));
        return !w.keys().hasAny(['startMonth', 'peakMonth', 'endMonth'])
          && peak is int && end is int && end <= 2200
          && w.startYear <= peak && peak <= end;
      }

      // A window in months: every date present has its month 1..12 (one
      // regular expression on the months; the arithmetic refuses a value that
      // is not a number), and year * 12 + month grows (BR10.2: March to
      // September of the same year passes, September to March does not). A
      // missing peak or end reads as a value that passes the order.
      function validMonthWindow(w) {
        let s = w.startYear * 12 + w.startMonth;
        let p = w.get('peakYear', w.startYear) * 12 + w.get('peakMonth', w.startMonth);
        let e = w.get('endYear', 2200) * 12 + w.get('endMonth', 12);
        return w.unit == 'months'
          && (string(w.startMonth) + '|' + string(w.get('peakMonth', 1)) + '|'
            + string(w.get('endMonth', 1))).matches(
            '^([1-9]|1[0-2])[|]([1-9]|1[0-2])[|]([1-9]|1[0-2])$')
          && ('peakYear' in w) == ('peakMonth' in w)
          && ('endYear' in w) == ('endMonth' in w)
          && p is int && e is int
          && s <= p && p <= e && e <= 26412;
      }

      function validAdjustment(a) {
        return a == null || (a is map
          // wine-style-profiles BR6.9: optional month of the drink.
          && a.keys().hasOnly(['kind', 'year', 'recordId', 'month'])
          && (!('month' in a) || (a.month is int && a.month >= 1 && a.month <= 12))
          && a.kind in ['tooYoung', 'justRight', 'pastPeak']
          && a.year is int && a.year >= 1900 && a.year <= 2200
          && a.recordId is string && a.recordId.size() >= 1 && a.recordId.size() <= 128);
      }

      function validMatchKey(k) {
        return k == null || (k is string && k.size() <= 400);
      }

      // Producer, region and denomination: optional texts of at most 120
      // characters (BR1.3; review R-05).
      function validOptionalText(t) {
        return t == null || (t is string && t.size() <= 120);
      }

      // The C3 `Pairings` shape: catalog texts or category keys, a source.
      function validPairings(p) {
        return p == null || (p is map
          && p.keys().hasOnly(['items', 'categoryKeys', 'source'])
          && p.source in ['catalog', 'internalRules']
          && (!('items' in p) || (p.items is list && p.items.size() <= 10))
          && (!('categoryKeys' in p)
            || (p.categoryKeys is list && p.categoryKeys.size() <= 10)));
      }

      // The u4-cellar fields of a wine, each optional (read with get).
      function validWineExtras(data) {
        // wine-style-profiles: a base window equal to the window (no
        // feedback, no correction) is checked once.
        return validWindow(data.get('window', null))
          && validBaseWindow(data.get('baseWindow', null), data.get('window', null))
          && validAdjustment(data.get('windowAdjustment', null))
          && validMatchKey(data.get('matchKey', null))
          && validOptionalText(data.get('producer', null))
          && validOptionalText(data.get('region', null))
          && validOptionalText(data.get('denomination', null))
          && validPairings(data.get('pairings', null))
          && validCountry(data.get('country', null))
          // (the level is checked with the classification)
          && validOverride(data.get('windowOverride', null))
          && validClassification(data);
      }

      // wine-style-profiles BR10.2: style and the three sources joined and
      // matched by one regular expression (a missing field reads as a valid
      // default; a value that is not a string makes it fail), then the date
      // and the migration version.
      function validClassification(data) {
        return (data.get('level', 'good') + '|'
            + data.get('style', 'redFresh') + '|' + data.get('typeSource', 'user') + '|'
            + data.get('levelSource', 'user') + '|' + data.get('styleSource', 'user')).matches(
            '^(everyday|good|aging)[|](redFresh|redMedium|redAge|redLong|whiteFresh|whiteMedium|whiteAge|'
            + 'roseFresh|tankFresh|lambrusco|classicFresh|classicAge|sweetAromatic|'
            + 'sweetPassito|sweetBotrytis|portVintage|portLbv|portTawny|sherryFino|'
            + 'sherryAmontillado|sherryOloroso|sherryPx|madeira|fortifiedOther)'
            + '[|](user|auto)[|](user|auto)[|](user|auto)$')
          && validAgingStart(data.get('agingStartMonth', null))
          && validMigrationVersion(data.get('migrationVersion', null));
      }

      function validWineName(name) {
        return name is string && name.size() >= 1 && name.size() <= 120;
      }

      // One year of tolerance for a phone clock ahead of the server (NFR4.5).
      function validVintage(vintage) {
        return vintage == null
          || (vintage is int && vintage >= 1900 && vintage <= request.time.year() + 1);
      }

      function validWineCreate() {
        let data = incoming();
        return data.keys().hasOnly(wineFields())
          && data.keys().hasAll(['name', 'quantity', 'createdAt', 'updatedAt', 'updatedBy'])
          && validWineName(data.name)
          && validVintage(data.get('vintage', null))
          && data.quantity is int
          && data.quantity >= 1
          && data.quantity <= 99
          && data.updatedBy == uid()
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && validWineExtras(data);
      }

      // Quantity changes arrive as increments and may go below 0 with
      // concurrent decrements (ADR-004): no lower bound on update.
      function validWineUpdate() {
        let data = incoming();
        let changed = data.diff(existing()).affectedKeys();
        return data.keys().hasOnly(wineFields())
          && !changed.hasAny(['createdAt'])
          && data.updatedBy == uid()
          && data.updatedAt == request.time
          && data.quantity is int
          // wine-style-profiles: fields checked in groups when one of them
          // changes (one test per group, for the expression budget).
          && (!changed.hasAny(['name', 'vintage', 'matchKey'])
            || (validWineName(data.name)
              && validVintage(data.get('vintage', null))
              && validMatchKey(data.get('matchKey', null))))
          && (!changed.hasAny(['window']) || validWindow(data.get('window', null)))
          && (!changed.hasAny(['baseWindow'])
            || validBaseWindow(data.get('baseWindow', null), data.get('window', null)))
          && (!changed.hasAny(['windowAdjustment'])
            || validAdjustment(data.get('windowAdjustment', null)))
          // 99-bottle cap of BR1.3 when the quantity changes; no lower bound,
          // a negative value from concurrent decrements stays valid (ADR-004).
          && (!changed.hasAny(['quantity']) || data.quantity <= 99)
          // wine-style-profiles: the three optional texts checked together
          // when one of them changes (expression budget).
          && (!changed.hasAny(['producer', 'region', 'denomination', 'country'])
            || (validOptionalText(data.get('producer', null))
              && validOptionalText(data.get('region', null))
              && validOptionalText(data.get('denomination', null))
              && validCountry(data.get('country', null))))
          && (!changed.hasAny(['pairings']) || validPairings(data.get('pairings', null)))
          // label-autofill-windows BR5.1: checked only when they change.
          && (!changed.hasAny(['windowOverride'])
            || validOverride(data.get('windowOverride', null)))
          // wine-style-profiles BR10.2: checked together when one of them
          // changes (one test instead of six, for the expression budget).
          && (!changed.hasAny(['level', 'style', 'typeSource', 'levelSource',
                               'styleSource', 'agingStartMonth', 'migrationVersion'])
            || validClassification(data));
      }

      // u4-cellar NFR4.2: the one-off backfill writes only matchKey, without
      // updatedBy and updatedAt, so it never looks like a user change.
      function validMatchKeyBackfill() {
        return onlyChanged(['matchKey'])
          && incoming().matchKey is string
          && validMatchKey(incoming().matchKey);
      }

      // Read: owner and active invitations; write: owner and active `edit`
      // invitations; delete: the owner only (u7 NFR4.1, Q3; u4-cellar uses
      // it for "Delete").
      match /wines/{wineId} {
        allow read: if signedIn() && canReadCellar(cellarId);
        allow create: if signedIn() && canEditCellar(cellarId) && validWineCreate();
        allow update: if signedIn() && canEditCellar(cellarId)
          && (validWineUpdate() || validMatchKeyBackfill());
        allow delete: if signedIn() && isOwner(cellarId);
      }

      // ---- cellars/{cellarId}/drinkingRecords/{recordId} (u7 NFR4.8;
      // u4-cellar NFR4.3-NFR4.5) -------------------------------------------

      function validRating(r) {
        return r == null || (r is int && r >= 1 && r <= 5);
      }

      function validNotes(n) {
        return n == null || (n is string && n.size() <= 1000);
      }

      function validDrankOn(d) {
        return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      function validCondition(c) {
        return c == null || c in ['tooYoung', 'justRight', 'pastPeak'];
      }

      // Replaces the u7-sharing version: `condition` and `updatedAt` are new
      // optional fields; every other constraint is unchanged.
      function validDrinkingRecord() {
        let data = incoming();
        return data.keys().hasOnly(['wineId', 'wineName', 'vintage', 'drankOn', 'rating',
                                    'notes', 'condition', 'recordedBy', 'createdAt',
                                    'updatedAt'])
          && data.keys().hasAll(['wineId', 'wineName', 'drankOn', 'recordedBy', 'createdAt'])
          && data.wineId is string
          && data.wineId.size() >= 1
          && data.wineId.size() <= 128
          && data.wineName is string
          && data.wineName.size() >= 1
          && data.wineName.size() <= 120
          && (data.get('vintage', null) == null
            || (data.vintage is int && data.vintage >= 1900 && data.vintage <= 2100))
          && validDrankOn(data.drankOn)
          && validRating(data.get('rating', null))
          && validNotes(data.get('notes', null))
          && validCondition(data.get('condition', null))
          && data.recordedBy == uid()
          && data.createdAt == request.time
          && (data.get('updatedAt', null) == null || data.updatedAt == request.time);
      }

      // Rating, notes, date and "How was it?" change; who drank, what and
      // when it was recorded never do (NFR4.3).
      function validDrinkingRecordUpdate() {
        let data = incoming();
        return data.diff(existing()).affectedKeys()
            .hasOnly(['rating', 'notes', 'drankOn', 'condition', 'updatedAt'])
          && data.updatedAt == request.time
          && validRating(data.get('rating', null))
          && validNotes(data.get('notes', null))
          && validDrankOn(data.drankOn)
          && validCondition(data.get('condition', null));
      }

      match /drinkingRecords/{recordId} {
        allow read: if signedIn() && canReadCellar(cellarId);
        allow create: if signedIn() && canEditCellar(cellarId) && validDrinkingRecord();
        allow update: if signedIn()
          && canEditCellar(cellarId)
          && (existing().recordedBy == uid() || isOwner(cellarId))
          && validDrinkingRecordUpdate();
        // The owner always (u8-account data deletion, u4 "Delete"); the
        // author only within 10 minutes, for "Undo" (NFR4.4). A document
        // already deleted is refused, so a second "Undo" of the same drink
        // fails with its whole batch, +1 included.
        allow delete: if signedIn()
          && resource != null
          && (isOwner(cellarId)
            || (canEditCellar(cellarId)
              && existing().recordedBy == uid()
              && request.time < existing().createdAt + duration.value(10, 'm')));
      }

      // ---- cellars/{cellarId}/members/{memberKey} (u7 BR1.13, NFR4.2) ----
      // memberKey is the invitee email in lower case. Only the transitions
      // of functional-spec.md are allowed; everything else is denied.

      match /members/{memberKey} {
        function cellarDoc() {
          return /databases/$(database)/documents/cellars/$(cellarId);
        }

        function memberSlotsNow() {
          return get(cellarDoc()).data.get('memberSlots', 0);
        }

        // The cellar of the same batch names this invitation and moves the
        // counter by exactly [delta].
        function pairedOp(delta) {
          return getAfter(cellarDoc()).data.get('memberOpKey', '') == memberKey
            && getAfter(cellarDoc()).data.get('memberSlots', 0) == memberSlotsNow() + delta;
        }

        function isSelf() {
          return verified() && memberKey == email();
        }

        function validEmailKey(value) {
          return value is string
            && value == memberKey
            && value == value.lower()
            && value.size() <= 254
            && value.matches('^[^@/\\s]+@[^@/\\s]+\\.[^@/\\s]+$');
        }

        function validDisplayName(value) {
          return value is string && value.size() >= 1 && value.size() <= 100;
        }

        function validPermission(value) {
          return value in ['read', 'edit'];
        }

        function stampedNow() {
          return incoming().updatedAt == request.time;
        }

        // (none) -> invited, by the owner, counter +1.
        function validInviteNew() {
          let data = incoming();
          let fields = ['inviteeEmail', 'permission', 'status', 'invitedAt', 'ownerId',
                        'ownerName', 'updatedAt'];
          return data.keys().hasOnly(fields)
            && data.keys().hasAll(fields)
            && validEmailKey(data.inviteeEmail)
            && data.inviteeEmail != email()
            && validPermission(data.permission)
            && data.status == 'invited'
            && data.invitedAt == request.time
            && data.ownerId == uid()
            && validDisplayName(data.ownerName)
            && stampedNow()
            && pairedOp(1);
        }

        // revoked -> invited, by the owner, counter +1; closedBy removed.
        function validReinvite() {
          let data = incoming();
          return existing().status == 'revoked'
            && data.status == 'invited'
            && onlyChanged(['status', 'permission', 'invitedAt', 'closedBy', 'updatedAt'])
            && !('closedBy' in data)
            && validPermission(data.permission)
            && data.invitedAt == request.time
            && stampedNow()
            && pairedOp(1);
        }

        // invited/active, same state, by the owner: permission only.
        function validPermissionChange() {
          return existing().status in ['invited', 'active']
            && onlyChanged(['permission', 'updatedAt'])
            && validPermission(incoming().permission)
            && stampedNow();
        }

        // invited/active -> revoked by the owner, counter -1.
        function validOwnerRevoke() {
          let data = incoming();
          return existing().status in ['invited', 'active']
            && data.status == 'revoked'
            && data.closedBy == 'owner'
            && onlyChanged(['status', 'closedBy', 'updatedAt'])
            && stampedNow()
            && pairedOp(-1);
        }

        // invited -> active by the invited person (BR1.4), no counter change.
        function validActivate() {
          let data = incoming();
          return existing().status == 'invited'
            && data.status == 'active'
            && onlyChanged(['status', 'inviteeUserId', 'inviteeName', 'updatedAt'])
            && data.inviteeUserId == uid()
            && validDisplayName(data.inviteeName)
            && stampedNow();
        }

        // active -> revoked by the invited person (BR1.10), counter -1.
        function validLeave() {
          let data = incoming();
          return existing().status == 'active'
            && data.status == 'revoked'
            && data.closedBy == 'invitee'
            && onlyChanged(['status', 'closedBy', 'updatedAt'])
            && stampedNow()
            && pairedOp(-1);
        }

        allow get: if signedIn() && (isOwner(cellarId) || isSelf());
        // Only the owner lists the invitations of a cellar (NFR4.5).
        allow list: if signedIn() && isOwner(cellarId);
        allow create: if signedIn() && isOwner(cellarId) && validInviteNew();
        allow update: if signedIn()
          && ((isOwner(cellarId)
              && (validReinvite() || validPermissionChange() || validOwnerRevoke()))
            || (isSelf() && (validActivate() || validLeave())));
        // A closed access only: "delete for good" by the owner, or the
        // invited person removing their own address (NFR8.3, u8-account).
        allow delete: if signedIn()
          && existing().status == 'revoked'
          && (isOwner(cellarId) || isSelf());
      }
    }

    // ---- Collection group members (u7 BR1.4, BR1.14, NFR4.5) --------------
    // A person reads only their own invitations, in every state, through the
    // query `inviteeEmail == own email` (index in firestore.indexes.json).
    match /{path=**}/members/{memberKey} {
      allow get, list: if signedIn()
        && verified()
        && resource.data.inviteeEmail == email();
    }
  }
}
